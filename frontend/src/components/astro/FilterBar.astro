---
// Plain <a href="?status=..."> links -- server-rendered, zero client JS,
// works with JavaScript disabled. This is the Islands architecture
// argument made concrete: filtering the catalog needs no hydration at all.
interface Props {
  current: string;
}
const { current } = Astro.props;

const filters: { value: string; label: string }[] = [
  { value: 'all', label: 'Todas' },
  { value: 'active', label: 'Activas' },
  { value: 'created', label: 'Próximas' },
  { value: 'finished', label: 'Finalizadas' },
];
---

<div class="mb-6 flex flex-wrap gap-2">
  {
    filters.map((f) => (
      <a
        href={f.value === 'all' ? '/auctions' : `/auctions?status=${f.value}`}
        class:list={[
          'rounded-full border px-4 py-1.5 text-sm font-medium transition',
          current === f.value
            ? 'border-indigo-600 bg-indigo-600 text-white'
            : 'border-slate-300 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800',
        ]}
      >
        {f.label}
      </a>
    ))
  }
</div>
