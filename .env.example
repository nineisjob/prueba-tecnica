# Reference for LOCAL (non-Docker) development only.
# docker-compose.yml sets these directly for the containerized services --
# it does not read this file. Copy relevant values here if you run
# `go run ./cmd/api` or `npm run dev` against a dockerized Postgres.

# --- backend ---
DATABASE_URL=postgres://bidcraft:bidcraft@localhost:5433/bidcraft?sslmode=disable
PORT=8080
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=24
DEFAULT_MIN_INCREMENT_CENTS=100
CORS_ALLOWED_ORIGINS=http://localhost:4321
SEED_DEMO_DATA=true
MIGRATE_ON_START=true
LOG_LEVEL=info

# --- frontend (astro dev) ---
API_INTERNAL_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080
